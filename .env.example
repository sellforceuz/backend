# ─── БАЗА ДАННЫХ ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Минимум 32 случайных символа! Сгенерируй на: https://generate-secret.vercel.app/64
JWT_SECRET=замени-это-на-случайную-строку-минимум-32-символа

# ─── АДМИНИСТРАТОР (создаётся автоматически при первом запуске) ────────────────
ADMIN_EMAIL=твой@email.com
ADMIN_PASSWORD=надёжный-пароль-минимум-12-символов

# ─── GOOGLE AI (Gemini) ────────────────────────────────────────────────────────
# Получить: https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=AIzaSy...

# ─── TELEGRAM ──────────────────────────────────────────────────────────────────
# Получить через @BotFather в Telegram → /newbot
TG_BOT_TOKEN=1234567890:AAF...

# ─── СЕРВЕР ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS (домен фронтенда) ────────────────────────────────────────────────────
# После деплоя фронтенда — вставь сюда его URL
FRONTEND_URL=https://твой-проект.vercel.app
